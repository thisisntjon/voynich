+def user_site_modules():
+    """(c3 item d) Names of loaded modules whose file is under the user site-packages. Must be empty."""
+    us = user_site_dirs()
+    bad = []
+    for name, m in list(sys.modules.items()):
+        f = getattr(m, "__file__", None)
+        if not f or not os.path.isabs(f):
