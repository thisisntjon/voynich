+
+def shared_block_bytes(path):
+    """(c3, D-33) The shared block "through the END line": from the start of the BEGIN line through the end of the
+    END line, without its final newline."""
+    b = Path(path).read_bytes()
+    i = b.index(("\n" + _SB_BEGIN).encode("utf-8")) + 1
+    j = b.index(("\n" + _SB_END).encode("utf-8"), i) + 1 + len(_SB_END)
+    return b[i:j]
+
